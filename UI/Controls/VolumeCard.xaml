<UserControl x:Class="SpotifyMediaFlyout.UI.Controls.VolumeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="76">

    <Border Background="#E6222222" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="8,10"
            Width="76"
            Height="160">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Click="OnMuteClick"
                    ToolTip="Mute / Unmute"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Style="{StaticResource MediaButtonStyle}">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White" Data="M3,9v6h4l5,5V4L7,9H3z"/>
                        
                        <Path x:Name="WaveLow" Fill="White" 
                              Data="M14.5,12c0,-1.77 -1.02,-3.29 -2.5,-4.03v8.05c1.48,-0.73 2.5,-2.25 2.5,-4.02z"
                              Visibility="Visible"/>
                        
                        <Path x:Name="WaveHigh" Fill="White" 
                              Data="M14,3.23v2.06c2.89,0.86 5,3.54 5,6.71s-2.11,5.85 -5,6.71v2.06c4.01,-0.91 7,-4.49 7,-8.77s-2.99,-7.86 -7,-8.77z"
                              Visibility="Visible"/>

                        <Path x:Name="MuteSlash" Stroke="#FF4444" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M2,2 L22,22"
                              Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Grid Grid.Row="1" Margin="0,8" HorizontalAlignment="Center" Width="24">
                <Slider x:Name="VolumeSlider"
                        Orientation="Vertical"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="2"
                        LargeChange="5"
                        IsMoveToPointEnabled="True"
                        ValueChanged="OnSliderValueChanged"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Cursor="Hand">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Width="4" 
                                        Background="#4DFFFFFF" 
                                        CornerRadius="2" 
                                        HorizontalAlignment="Center"/>

                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Width="4" 
                                                            Background="#FFFFFF" 
                                                            CornerRadius="2" 
                                                            HorizontalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="#FFFFFF" 
                                                             Stroke="#1A1A1A" 
                                                             StrokeThickness="2">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="TxtVolume"
                       Text="70"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
