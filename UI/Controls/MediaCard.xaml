<UserControl x:Class="SpotifyMediaFlyout.UI.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="310">

    <Border Background="#E6222222" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="14,12"
            Width="310"
            Height="160">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="ActiveLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,10">
                        <Button x:Name="BtnPrevious"
                                Click="OnPreviousClick"
                                ToolTip="Anterior"
                                Width="34" Height="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource MediaButtonStyle}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M6,6h2v12H6V6zm3.5,6l8.5,6V6l-8.5,6z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="BtnPlayPause"
                                Click="OnPlayPauseClick"
                                ToolTip="Reproduzir / Pausar"
                                Width="38" Height="38"
                                Margin="0,0,6,0"
                                Style="{StaticResource MediaButtonStyle}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PlayIcon" Fill="White" Data="M8,5.14v14l11,-7l-11,-7z" Visibility="Collapsed"/>
                                    <Path x:Name="PauseIcon" Fill="White" Data="M6,19h4V5H6v14zm8,-14v14h4V5h-4z" Visibility="Visible"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="BtnNext"
                                Click="OnNextClick"
                                ToolTip="Próxima"
                                Width="34" Height="34"
                                Style="{StaticResource MediaButtonStyle}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M6,18l8.5,-6L6,6v12zM16,6v12h2V6h-2z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock x:Name="TxtTitle"
                                   Text="Título da Música"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,0,3"/>
                        
                        <TextBlock x:Name="TxtArtist"
                                   Text="Artista"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,4,0,0">
                        <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                            <Path Fill="#1DB954" Data="M12 2C6.477 2 2 6.477 2 12c0 5.524 4.477 10 10 10 5.524 0 10-4.476 10-10 0-5.523-4.476-10-10-10zm4.586 14.424c-.18.295-.563.387-.857.207-2.348-1.435-5.304-1.76-8.785-.963-.335.077-.67-.133-.746-.468-.077-.334.132-.67.467-.746 3.808-.87 7.076-.496 9.714 1.115.294.18.386.562.207.855zm1.225-2.724c-.226.367-.708.482-1.075.257-2.687-1.652-6.785-2.131-9.965-1.166-.413.127-.848-.106-.973-.518-.126-.413.107-.849.52-.973 3.632-1.102 8.147-.568 11.236 1.325.367.226.48.708.257 1.075zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71c-.493.15-1.016-.128-1.165-.62-.15-.493.128-1.016.62-1.166 3.532-1.072 9.404-.866 13.115 1.338.445.264.59.838.327 1.282-.264.443-.838.59-1.28.32z"/>
                        </Viewbox>
                        <TextBlock Text="Spotify" Foreground="#888888" FontSize="10" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Width="84" Height="84"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="#2E2E2E"
                        VerticalAlignment="Center"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Viewbox Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="#555555" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </Viewbox>

                        <Image x:Name="ImgArtwork"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="InactiveLayout" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,0,8">
                        <Path Fill="#666666" Data="M12 2C6.477 2 2 6.477 2 12c0 5.524 4.477 10 10 10 5.524 0 10-4.476 10-10 0-5.523-4.476-10-10-10zm4.586 14.424c-.18.295-.563.387-.857.207-2.348-1.435-5.304-1.76-8.785-.963-.335.077-.67-.133-.746-.468-.077-.334.132-.67.467-.746 3.808-.87 7.076-.496 9.714 1.115.294.18.386.562.207.855zm1.225-2.724c-.226.367-.708.482-1.075.257-2.687-1.652-6.785-2.131-9.965-1.166-.413.127-.848-.106-.973-.518-.126-.413.107-.849.52-.973 3.632-1.102 8.147-.568 11.236 1.325.367.226.48.708.257 1.075zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71c-.493.15-1.016-.128-1.165-.62-.15-.493.128-1.016.62-1.166 3.532-1.072 9.404-.866 13.115 1.338.445.264.59.838.327 1.282-.264.443-.838.59-1.28.32z"/>
                    </Viewbox>
                    <TextBlock Text="Spotify pausado / inativo" 
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               FontSize="13" 
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
